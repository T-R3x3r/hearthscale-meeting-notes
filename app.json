{
  "$schema": "https://hearthscale.com/app.schema.json",
  "id": "meeting-notes",
  "name": "Meeting notes",
  "version": "2.0.0",
  "api": 6,
  "icon": {
    "light": "assets/icon-light.svg",
    "dark": "assets/icon-dark.svg"
  },
  "description": "Hears your meetings on this computer, shows every word as people speak, and writes clear notes when each one ends.",
  "license": "MIT",
  "categories": [
    "notes",
    "productivity"
  ],
  "payment": "free",
  "environment": {
    "kind": "process",
    "lifetime": "service"
  },
  "permissions": [
    "clipboard-write"
  ],
  "onboarding": {
    "version": 1,
    "cards": [
      {
        "title": "Notes of every meeting.",
        "text": "Meeting notes hears your meetings on this computer and writes clear notes when each one ends."
      },
      {
        "title": "What a meeting holds.",
        "rows": [
          { "icon": "transcript", "title": "Transcript", "text": "Every word, with who said it and when." },
          { "icon": "pen", "title": "Notes", "text": "Your own points, and the notes written from the meeting." },
          { "icon": "view", "title": "Meeting types", "text": "Pick one, and the notes follow its sections." },
          { "icon": "question", "title": "Ask", "text": "Questions about one meeting, or all of them." },
          { "icon": "keyboard", "title": "Saved requests", "text": "Requests you make often, in the / menu of Ask." }
        ]
      },
      {
        "title": "Good for any meeting.",
        "rows": [
          { "icon": "clock", "title": "Team meetings", "text": "Decisions and next steps, each with its owner." },
          { "icon": "speech", "title": "Customer calls", "text": "What the customer needs, in their own words." },
          { "icon": "search", "title": "Interviews", "text": "Every answer, with its question." },
          { "icon": "check", "title": "One-on-ones", "text": "Feedback and goals, kept for next time." }
        ]
      }
    ]
  },
  "uses": [
    "store",
    "events",
    "sessions",
    "index",
    "models",
    "jobs",
    "capture.microphone",
    "capture.system-sound",
    "notifications"
  ],
  "models": {
    "chat": {
      "required": true
    },
    "transcription": {
      "required": true
    },
    "diarization": {
      "required": false
    },
    "embedding": {
      "required": false
    }
  },
  "agent": {
    "name": "Meeting notes",
    "description": "Answers questions about the person's meetings and changes their notes.",
    "model": {
      "kind": "chat",
      "tools": true
    },
    "prompt": [
      "prompt/system.md"
    ],
    "tools": [
      "search_meetings",
      "list_meetings",
      "read_meeting",
      "set_notes"
    ],
    "compaction": {
      "focus": "The meetings the person asked about, with their ids and dates, and what the person wants from them."
    }
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Your name in the transcript",
          "minLength": 1,
          "maxLength": 40,
          "default": "Me"
        },
        "about": {
          "type": "string",
          "title": "About you",
          "description": "Your role and your work, which the notes take into account.",
          "maxLength": 500,
          "default": ""
        },
        "language": {
          "type": "string",
          "title": "Meeting language",
          "enum": [
            "Detect",
            "English",
            "German",
            "French",
            "Spanish",
            "Italian",
            "Portuguese",
            "Dutch",
            "Polish",
            "Swedish",
            "Danish",
            "Norwegian",
            "Finnish",
            "Japanese",
            "Chinese",
            "Korean"
          ],
          "default": "Detect"
        },
        "notesLanguage": {
          "type": "string",
          "title": "Notes language",
          "enum": [
            "As the meeting",
            "English",
            "German",
            "French",
            "Spanish",
            "Italian",
            "Portuguese",
            "Dutch",
            "Polish",
            "Swedish",
            "Danish",
            "Norwegian",
            "Finnish",
            "Japanese",
            "Chinese",
            "Korean"
          ],
          "default": "As the meeting"
        },
        "words": {
          "type": "string",
          "title": "Words to know",
          "description": "Names and terms your meetings use, separated by commas. Only some transcription models use them.",
          "maxLength": 1000,
          "default": ""
        },
        "template": {
          "type": "string",
          "title": "Meeting type",
          "enum": [
            "Auto",
            "One-on-one",
            "Stand-up",
            "Team meeting",
            "Customer discovery",
            "Sales call",
            "Job interview",
            "User interview",
            "Sprint planning",
            "Retrospective",
            "Investor update",
            "Pitch",
            "Class or talk"
          ],
          "default": "Auto"
        },
        "askOnCall": {
          "type": "boolean",
          "title": "Ask to take notes when a call starts",
          "default": true
        },
        "recordOnCall": {
          "type": "boolean",
          "title": "Start recording when a call starts",
          "default": false
        }
      }
    },
    "layout": [
      {
        "title": "You",
        "items": [
          {
            "kind": "property",
            "property": "name"
          },
          {
            "kind": "property",
            "property": "about"
          }
        ]
      },
      {
        "title": "Language",
        "items": [
          {
            "kind": "property",
            "property": "language"
          },
          {
            "kind": "property",
            "property": "notesLanguage"
          },
          {
            "kind": "property",
            "property": "words"
          }
        ]
      },
      {
        "title": "Notes",
        "items": [
          {
            "kind": "property",
            "property": "template"
          }
        ]
      },
      {
        "title": "Calls",
        "items": [
          {
            "kind": "property",
            "property": "askOnCall"
          },
          {
            "kind": "property",
            "property": "recordOnCall"
          }
        ]
      }
    ]
  },
  "triggers": [
    {
      "name": "record",
      "kind": "tray",
      "title": "Start recording"
    },
    {
      "name": "call",
      "kind": "device-in-use",
      "devices": [
        "microphone"
      ]
    }
  ],
  "tools": [
    {
      "name": "meetings",
      "title": "List meetings",
      "description": "Every meeting, newest first.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "meeting",
      "title": "Open meeting",
      "description": "One meeting with its notes, the person's notes and its transcript.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "transcribe_recording",
      "title": "Transcribe a recording",
      "description": "Makes a meeting from a recording the person gave, and writes its notes.",
      "input": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "asset",
          "name"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "new_meeting",
      "title": "New meeting",
      "description": "Makes a new meeting with no recording.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "rename",
      "title": "Rename meeting",
      "description": "Gives a meeting the title the person typed.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "save_mine",
      "title": "Save my notes",
      "description": "Keeps what the person wrote in a meeting.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "save_notes",
      "title": "Save notes",
      "description": "Keeps the person's changes to a meeting's notes.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "edit_line",
      "title": "Edit transcript line",
      "description": "Changes the words of one transcript line.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "n",
          "text"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "delete_lines",
      "title": "Delete transcript lines",
      "description": "Deletes lines of a meeting's transcript.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "lines"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "restore_lines",
      "title": "Restore transcript lines",
      "description": "Puts deleted lines back into a meeting's transcript.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 1
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "me",
                    "them"
                  ]
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string",
                  "pattern": "^s[0-9]+$"
                }
              },
              "required": [
                "n",
                "side",
                "start",
                "end",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "lines"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "name_speaker",
      "title": "Name speaker",
      "description": "Gives a speaker of a meeting the name the person typed, or takes it away when the name is empty.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "speaker": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "speaker",
          "name"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "delete_meeting",
      "title": "Delete meeting",
      "description": "Deletes a meeting and its files.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "record",
      "title": "Start recording",
      "description": "Starts recording a meeting, a new one when no id is given.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "pause",
      "title": "Pause recording",
      "description": "Pauses the recording.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "resume",
      "title": "Resume recording",
      "description": "Goes on recording after a pause.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "stop",
      "title": "Stop recording",
      "description": "Ends the recording, then writes the notes.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "templates",
      "title": "List my meeting types",
      "description": "The person's own meeting types (note templates).",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "save_template",
      "title": "Save meeting type",
      "description": "Keeps a meeting type (note template) of the person's own: its name, the meetings it suits, and its sections.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "about": {
            "type": "string",
            "maxLength": 300
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string",
                  "maxLength": 80
                },
                "guide": {
                  "type": "string",
                  "maxLength": 300
                }
              },
              "required": [
                "heading",
                "guide"
              ],
              "additionalProperties": false
            },
            "maxItems": 12
          }
        },
        "required": [
          "name",
          "about",
          "sections"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "delete_template",
      "title": "Delete meeting type",
      "description": "Deletes a meeting type of the person's own.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "requests",
      "title": "List saved requests",
      "description": "The person's own saved requests.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "save_request",
      "title": "Save request",
      "description": "Keeps a saved request of the person's own, which the assistant's / menu then lists.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "delete_request",
      "title": "Delete request",
      "description": "Deletes a saved request of the person's own.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "microphones",
      "title": "List microphones",
      "description": "The microphones of the computer and the one the person chose.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "choose_microphone",
      "title": "Choose microphone",
      "description": "Records from the microphone of this name, or from the system's default when the name is empty.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "recording",
      "title": "Check the recording",
      "description": "The recording that runs now, if one does.",
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "write_notes",
      "title": "Write notes",
      "description": "Starts writing a meeting's notes again with a meeting type, by its template id.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "template"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "stop_work",
      "title": "Stop",
      "description": "Stops the transcription, the speaker search or the notes of a meeting while they run.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "visibility": [
        "app"
      ]
    },
    {
      "name": "search_meetings",
      "title": "Search meetings",
      "description": "Searches the notes, the person's notes and the transcripts of all meetings. Answers passages with the meeting's id, title, date and the part they come from. Use it to find which meetings talked about something.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words or a question to look for."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "How many passages at most; 8 when absent."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "icon": "search"
    },
    {
      "name": "list_meetings",
      "title": "List meetings",
      "description": "Lists meetings, newest first, with id, title, date and length. Narrow it by a date range and words of the title.",
      "input": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "The earliest date, as an ISO date such as 2026-10-01."
          },
          "to": {
            "type": "string",
            "description": "The latest date, as an ISO date."
          },
          "words": {
            "type": "string",
            "description": "Words the title holds."
          }
        },
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "icon": "scroll"
    },
    {
      "name": "read_meeting",
      "title": "Read meeting",
      "description": "Reads one meeting by its id: its notes, the person's own notes, or its transcript with the time and speaker of each line. A long transcript comes in pages: read on from the number in `next`.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The meeting's id."
          },
          "part": {
            "type": "string",
            "enum": [
              "notes",
              "my notes",
              "transcript"
            ]
          },
          "from": {
            "type": "integer",
            "minimum": 0,
            "description": "The first transcript line to read, counted from 0."
          }
        },
        "required": [
          "id",
          "part"
        ],
        "additionalProperties": false
      },
      "mutating": false,
      "outbound": false,
      "icon": "transcript"
    },
    {
      "name": "set_notes",
      "title": "Change notes",
      "description": "Replaces a meeting's notes with the Markdown you give. Keep the person's own lines as they are, and put every word you write inside <span data-model>…</span>.",
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "markdown": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "markdown"
        ],
        "additionalProperties": false
      },
      "mutating": true,
      "outbound": false,
      "icon": "pen",
      "visibility": [
        "model"
      ]
    },
    {
      "name": "mention_meetings",
      "title": "Find meetings",
